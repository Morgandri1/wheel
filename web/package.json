{
  "name": "wheel-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:mock": "concurrently -n mock,next -c magenta,cyan \"pnpm mock\" \"next dev --port 3000\"",
    "mock": "tsx mock/server.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "gen:types": "tsx scripts/gen-types.ts",
    "copy:monaco": "node scripts/copy-monaco.mjs",
    "prebuild": "node scripts/copy-monaco.mjs",
    "predev": "node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.9.6",
    "@monaco-editor/react": "^4.6.0",
    "@tanstack/react-query": "^5.62.7",
    "@xyflow/react": "^12.3.6",
    "monaco-editor": "0.52.2",
    "next": "15.1.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^15.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": "22.x"
  }
}
