# Point at the mock server (pnpm mock) or the real API.
NEXT_PUBLIC_API_URL=http://localhost:8787
# mock | clerk  — "mock" swaps the token provider only; every call site is identical.
NEXT_PUBLIC_AUTH_MODE=mock
# Required when NEXT_PUBLIC_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
