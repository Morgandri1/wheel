# ─────────────────────────────────────────────────────────────────────────────
# web/ environment variables. Copy to .env.local for local work.
#
# Every NEXT_PUBLIC_* value is INLINED INTO THE CLIENT BUNDLE AT BUILD TIME.
# Changing one needs a rebuild, not a restart, and it is world-readable in the
# browser — never put a secret behind that prefix.
#
# Full reference, including what breaks when each is wrong: web/DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required in every deployment ─────────────────────────────────────────────

# Base URL of the Wheel API. No trailing slash.
#   local mock  http://localhost:8787   (pnpm mock)
#   staging     https://wheel-api-production.up.railway.app
#   production  https://api.wheel.dev
# This is also baked into the CSP's connect-src, so a wrong value is blocked by
# the browser before the request is sent, not refused by the API.
NEXT_PUBLIC_API_URL=http://localhost:8787

# Which token provider the app uses. The API's own AUTH_MODE must agree.
#   mock   the bundled mock server (pnpm mock); a constant token, no sign-in
#   dev    the real API with WHEEL_ENV=dev; paste a minted token below
#   local  email/password sessions issued by the API itself  ← what we deploy
#   clerk  a real Clerk session
# An unrecognised value is NOT rejected: sign-in appears to succeed and then
# every API call 401s. Spell it exactly.
NEXT_PUBLIC_AUTH_MODE=mock

# ── Only when NEXT_PUBLIC_AUTH_MODE=dev ──────────────────────────────────────

# Mint with infra/dev/e2e.py's mint(). Never a production credential — this
# ends up in the client bundle.
NEXT_PUBLIC_DEV_TOKEN=

# ── Only when NEXT_PUBLIC_AUTH_MODE=clerk ────────────────────────────────────

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ — that publishes it.
CLERK_SECRET_KEY=

# ── Optional, local development only ─────────────────────────────────────────

# Give a second dev server its own build directory. Two `next dev` sharing one
# .next corrupt each other's cache, and the symptom is a 500 on the server you
# were not touching.
# NEXT_DIST_DIR=.next-local

# ── The mock server (pnpm mock) reads these; the app never does ──────────────

# MOCK_PORT=8787
# Comma-separated CORS allow-list. A browser cannot tell a CORS refusal from an
# unreachable server, so a missing origin here shows up as "Can't reach the API".
# MOCK_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Seed N extra nodes to test board performance at scale.
# MOCK_BULK_NODES=0
