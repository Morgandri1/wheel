# Point at the mock server (pnpm mock) or the real API.
NEXT_PUBLIC_API_URL=http://localhost:8787
# mock | dev | clerk  — swaps the token provider only; every call site is identical.
#   mock  the bundled mock server (pnpm mock)
#   dev   the real API with WHEEL_ENV=dev; paste a minted HS256 token below
#   clerk a real Clerk session
NEXT_PUBLIC_AUTH_MODE=mock
# Only for AUTH_MODE=dev. Mint with infra/dev/e2e.py's mint(); never a production credential.
NEXT_PUBLIC_DEV_TOKEN=
# Required when NEXT_PUBLIC_AUTH_MODE=clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
