# ─────────────────────────────────────────────────────────────────────────────
# web/ environment variables. Copy to .env.local for local work.
#
# The browser talks only to this app's server; the server talks to the API.
# Every variable without a NEXT_PUBLIC_ prefix is SERVER-ONLY and read at run
# time: change it and restart, no rebuild. A NEXT_PUBLIC_ value is inlined into
# the bundle at build time and is world-readable — never put a secret there.
#
# Full reference, including what breaks when each is wrong: web/DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server-only, read at run time ────────────────────────────────────────────

# Where this server reaches the Wheel API. Never sent to the browser, so the API
# can listen on loopback or a private network.
#   wheeld on this machine   http://127.0.0.1:8080   (the default when unset)
#   local mock               http://127.0.0.1:8787   (pnpm mock; `pnpm dev:mock` sets it)
#   compose / k8s            http://<api-service>:8080
#   production               https://api.wheel.dev
WHEEL_API_URL=http://127.0.0.1:8787

# Which auth mode this server runs. The API's own AUTH_MODE must agree.
#   mock   the bundled mock server; a constant token, no sign-in
#   dev    the real API with WHEEL_ENV=dev; the token is WHEEL_DEV_TOKEN below
#   local  email/password sessions issued by the API, kept in an httpOnly cookie  ← what we deploy
#   clerk  a real Clerk session, read server-side
# An unrecognised value makes the server refuse to render, with the reason in its log.
WHEEL_AUTH_MODE=mock

# Only when WHEEL_AUTH_MODE=dev. Mint with infra/dev/e2e.py's mint(). This server
# presents it on behalf of EVERY visitor.
WHEEL_DEV_TOKEN=

# A production server refuses to start in mock or dev (one credential for every
# visitor; mock is also what an unset WHEEL_AUTH_MODE means) unless this says so.
# WHEEL_ALLOW_INSECURE_AUTH=1

# The origin browsers use. Required behind a TLS proxy and for any address but
# localhost: without it (or a trusted proxy) /api answers a loopback Host only.
# What this and the next setting mean: web/DEPLOY.md, "The trust model".
# WHEEL_PUBLIC_ORIGIN=https://wheel.example.com

# Take the public origin from a trusted proxy's X-Forwarded-Proto/-Host instead.
# On by default on Vercel (VERCEL=1).
# WHEEL_TRUST_PROXY=1

# Request bodies above this are refused with 413 before they are buffered. Keep it
# equal to the API's INGRESS_BODY_LIMIT_BYTES. Default 5 MiB.
# WHEEL_PROXY_BODY_LIMIT_BYTES=5242880

# ── Only when WHEEL_AUTH_MODE=clerk ──────────────────────────────────────────

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SERVER ONLY. Never prefix this with NEXT_PUBLIC_ — that publishes it.
CLERK_SECRET_KEY=

# ── Legacy names, still honoured by the server as fallbacks ──────────────────
# NEXT_PUBLIC_API_URL    → use WHEEL_API_URL (the fallback is frozen at build time)
# NEXT_PUBLIC_AUTH_MODE  → use WHEEL_AUTH_MODE
# NEXT_PUBLIC_DEV_TOKEN  → REMOVED: it put the token in the bundle. Use WHEEL_DEV_TOKEN.

# ── Optional, local development only ─────────────────────────────────────────

# Give a second dev server its own build directory. Two `next dev` sharing one
# .next corrupt each other's cache, and the symptom is a 500 on the server you
# were not touching.
# NEXT_DIST_DIR=.next-local

# ── The mock server (pnpm mock) reads these; the app never does ──────────────

# MOCK_PORT=8787
# Comma-separated CORS allow-list. Only a browser calling the mock directly needs
# it, and the web app no longer does: its server calls the mock.
# MOCK_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Seed N extra nodes to test board performance at scale.
# MOCK_BULK_NODES=0
