#!/usr/bin/env python3
"""fake-codex — deterministic stand-in for the `codex` CLI (`codex exec --json`).

PROVISIONAL: the real codex JSONL event names below are modelled on
codex-cli 0.149.x `codex exec --json` (thread/turn/item events). They have NOT
yet been verified against the real binary (that needs an authenticated login).
SDK: confirm before M2 wires up harness:"codex"; QA will re-pin this file then.
Tracked as TESTPLAN open question Q-HARNESS-CODEX.
"""
import json, os, sys, uuid, time, re, hashlib

# ---------------------------------------------------------------------------
# Steering configuration.
#
# The engine starts every child from an empty environment and repopulates only a
# short allowlist (supervisor/mod.rs INHERITED_ENV, ADVERSARY F015). That is
# correct and must stay that way -- an allowlist that grows test-only entries is
# how a deny-by-default list rots -- so these fakes cannot be steered by
# inherited WHEEL_FAKE_* variables any more. They read a file instead.
#
# Precedence is env first, then the file, so running a fake DIRECTLY (the
# harness selftest does) still works exactly as before.
# ---------------------------------------------------------------------------
FAKE_CONFIG_PATH = os.environ.get("WHEEL_FAKE_CONFIG") or "/data/wheel-fake.json"


def _fake_config():
    try:
        with open(FAKE_CONFIG_PATH) as fh:
            cfg = json.load(fh)
    except (OSError, ValueError):
        return {}
    if not isinstance(cfg, dict):
        return {}
    # Per-node overrides win over the defaults, so one file can steer a whole board.
    node = os.environ.get("WHEEL_NODE")
    merged = {k: v for k, v in cfg.items() if k != "nodes"}
    merged.update((cfg.get("nodes") or {}).get(node) or {})
    return merged


FAKE_CFG = _fake_config()


def fake_opt(env_name, key):
    """A steering value from the environment if present, else from the config file."""
    v = os.environ.get(env_name)
    return v if v is not None else FAKE_CFG.get(key)


# [A-Z0-9_]+, not [A-Z_]+: the name SH_B64 contains digits, so the original pattern
# matched "SH_B" and then failed on the "6" -- every <<FAKE:SH_B64=...>> ever sent was
# echoed back as literal text instead of being executed. The directive that runs a real
# command in the sandbox had therefore never worked, and wheel-on-wheel, which is built
# entirely on it, could never have passed.
DIRECTIVE = re.compile(r"<<FAKE:([A-Z0-9_]+)(?:=([^>]*))?>>")
TRANSCRIPT = fake_opt("WHEEL_FAKE_TRANSCRIPT", "transcript")
# Where the per-spawn credential-routing record goes.
#
# The engine deliberately does NOT pass its own environment to children (F015): it clears
# the env and re-adds a short allowlist, so a dump path exported to the ENGINE container
# cannot reach this child at all. The harness therefore has to know its own default. An
# explicit WHEEL_FAKE_ENV_DUMP still wins for anything spawned directly by a test.
DEFAULT_ENV_DUMP = "/data/wheel-fake-env.jsonl"


ENV_DUMP = fake_opt("WHEEL_FAKE_ENV_DUMP", "env_dump") or (
    # isdir alone is not enough: a shared multi-tenant host can have /data as a real,
    # listable directory that this uid still cannot write into (only /data/projects/<id>
    # is ours). isdir there is true and every spawn then dies in env_dump() trying to
    # write it -- one unwritable default took out the whole selftest suite, not just the
    # credential-routing checks, because env_dump() runs on every spawn unconditionally.
    DEFAULT_ENV_DUMP if os.access(os.path.dirname(DEFAULT_ENV_DUMP), os.W_OK) else None)
# sha256 digests a test wants located by NAME in this child's environment.
# Names are the answer; values never leave this process.
SENTINELS = [d for d in (fake_opt("WHEEL_FAKE_ENV_SENTINELS", "env_sentinels") or "").split(",") if d]

# Duplicated from fake-claude rather than shared: both files are installed standalone on
# the image's PATH, so a sibling import would not resolve. §4 makes this worth testing for
# codex specifically — it authenticates with CODEX_API_KEY and IGNORES OPENAI_API_KEY, so a
# key routed to the obvious-looking variable fails as "not logged in".
CRED_VARS = ("CODEX_API_KEY", "OPENAI_API_KEY", "ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN")
# CARGO_HOME/RUSTUP_HOME: ADVERSARY 029 is about WHERE they point, so they have to be
# recorded or the assertion can only ever skip.
CONFIG_VARS = ("CODEX_HOME", "CLAUDE_CONFIG_DIR", "WHEEL_TOKEN_FILE", "WHEEL_TOKEN",
               "IS_SANDBOX", "CARGO_HOME", "RUSTUP_HOME", "HOME")

def credential_class(v):
    if v.startswith("sk-ant-oat"): return "oauth_token"
    if v.startswith("sk-ant-api"): return "api_key"
    if v.startswith("sk-ant-"): return "anthropic_unknown"
    if v.startswith("sk-"): return "openai_style"
    return "opaque"

def env_dump():
    """One JSONL record per spawn: which credential vars were set, never their values."""
    if not ENV_DUMP: return
    creds = {}
    for name in CRED_VARS:
        v = os.environ.get(name)
        if v is None: continue
        creds[name] = {"bytes": len(v.encode()), "sha256": hashlib.sha256(v.encode()).hexdigest(),
                       "class": credential_class(v)}
    rec = {"pid": os.getpid(), "argv0": os.path.basename(sys.argv[0]),
           "uid": os.geteuid() if hasattr(os, "geteuid") else None,
           "credentials": creds, "credential_vars_set": sorted(creds),
           # The working directory the engine gave this child. Recorded because
           # WHERE an agent writes is a security property: a clone landing beside
           # the credentials directory is a finding, and nothing else observes it.
           "cwd": os.getcwd(),
           "config": {k: os.environ.get(k) for k in CONFIG_VARS if os.environ.get(k) is not None},
           "argv": sys.argv[1:]}
    try:
        with open(ENV_DUMP, "a") as fh:
            fh.write(json.dumps(rec, separators=(",", ":")) + "\n")
    except OSError as e:
        sys.stderr.write("fake-codex: cannot write WHEEL_FAKE_ENV_DUMP %s: %s\n" % (ENV_DUMP, e))
        sys.exit(2)

def emit(o):
    sys.stdout.write(json.dumps(o, separators=(",", ":")) + "\n"); sys.stdout.flush()

def main():
    argv = sys.argv[1:]
    env_dump()
    if "--version" in argv:
        print("codex-cli 0.149.1"); return 0
    # `codex exec [--json] [-c k=v]... [PROMPT]`
    if argv and argv[0] in ("exec", "e"):
        argv = argv[1:]
    prompt, i = None, 0
    while i < len(argv):
        t = argv[i]
        if t in ("--json", "--experimental-json"): pass
        elif t in ("-c", "--config", "-m", "--model", "-o", "--output-last-message",
                   "--output-schema", "--sandbox", "--cd", "-C"): i += 1
        elif t.startswith("-"): pass
        else: prompt = t
        i += 1

    thread_id = fake_opt("WHEEL_FAKE_SESSION_ID", "session_id") or str(uuid.uuid4())
    emit({"type": "thread.started", "thread_id": thread_id})

    turn = 0
    if prompt is not None:
        turn += 1; respond(prompt, turn, thread_id)
    else:
        for line in sys.stdin:
            line = line.rstrip("\n")
            if not line.strip(): continue
            if TRANSCRIPT:
                try:
                    with open(TRANSCRIPT, "a") as f: f.write(line + "\n")
                except OSError: pass
            try:
                o = json.loads(line); text = o.get("message") or o.get("text") or line
                if isinstance(text, list):
                    text = "\n".join(b.get("text", "") for b in text if isinstance(b, dict))
            except json.JSONDecodeError:
                text = line
            turn += 1; respond(text, turn, thread_id)
    return 0

def respond(text, turn, thread_id):
    d = {m.group(1): (m.group(2) if m.group(2) is not None else "") for m in DIRECTIVE.finditer(text or "")}
    if "SLEEP" in d: time.sleep(float(d["SLEEP"] or 1))
    if "EXIT" in d: sys.exit(int(d["EXIT"] or 1))
    reply = d.get("REPLY", "[fake-codex] turn %d: %s" % (turn, (text or "").strip()))
    reply = DIRECTIVE.sub("", reply).strip()
    emit({"type": "turn.started"})
    emit({"type": "item.completed", "item": {"id": "item_" + hashlib.sha256(reply.encode()).hexdigest()[:12],
          "type": "agent_message", "text": reply}})
    if "ERROR" in d:
        emit({"type": "turn.failed", "error": {"message": d.get("ERROR") or "fake error"}})
    else:
        emit({"type": "turn.completed", "usage": {"input_tokens": max(1, len(text or "") // 4),
              "cached_input_tokens": 0, "output_tokens": max(1, len(reply) // 4)}})

if __name__ == "__main__":
    try: sys.exit(main())
    except BrokenPipeError: sys.exit(0)
    except KeyboardInterrupt: sys.exit(130)
