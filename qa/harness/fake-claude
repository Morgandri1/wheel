#!/usr/bin/env python3
"""fake-claude — deterministic stand-in for the `claude` CLI.

Installed as /usr/local/bin/claude in the `wheel-engine:test` image variant.
Speaks the SAME stream-json protocol as Claude Code 2.1.x (verified against the
real binary), but never makes a network call. See qa/harness/README.md for the
full contract.

Design rules:
  * Deterministic: same input -> same output, except session_id/uuid/timestamps.
  * Echoing: the assistant reply CONTAINS the user text it received, so tests can
    assert that injected ctx markdown / [wheel] message framing reached the prompt.
  * Steerable from the test side via <<FAKE:...>> directives in the message body
    and via WHEEL_FAKE_* env vars, so QA never has to rebuild the image.
"""
import base64, json, os, subprocess, sys, time, uuid, re, hashlib, datetime, signal

# ---------------------------------------------------------------------------
# Steering configuration.
#
# The engine starts every child from an empty environment and repopulates only a
# short allowlist (supervisor/mod.rs INHERITED_ENV, ADVERSARY F015). That is
# correct and must stay that way -- an allowlist that grows test-only entries is
# how a deny-by-default list rots -- so these fakes cannot be steered by
# inherited WHEEL_FAKE_* variables any more. They read a file instead.
#
# Precedence is env first, then the file, so running a fake DIRECTLY (the
# harness selftest does) still works exactly as before.
# ---------------------------------------------------------------------------
FAKE_CONFIG_PATH = os.environ.get("WHEEL_FAKE_CONFIG") or "/data/wheel-fake.json"


def _fake_config():
    try:
        with open(FAKE_CONFIG_PATH) as fh:
            cfg = json.load(fh)
    except (OSError, ValueError):
        return {}
    if not isinstance(cfg, dict):
        return {}
    # Per-node overrides win over the defaults, so one file can steer a whole board.
    node = os.environ.get("WHEEL_NODE")
    merged = {k: v for k, v in cfg.items() if k != "nodes"}
    merged.update((cfg.get("nodes") or {}).get(node) or {})
    return merged


FAKE_CFG = _fake_config()


def fake_opt(env_name, key):
    """A steering value from the environment if present, else from the config file."""
    v = os.environ.get(env_name)
    return v if v is not None else FAKE_CFG.get(key)


VERSION = "2.1.261 (Claude Code)"
SCRIPT_PATH = fake_opt("WHEEL_FAKE_SCRIPT", "script")  # JSONL of canned turns, one object per turn
TRANSCRIPT = fake_opt("WHEEL_FAKE_TRANSCRIPT", "transcript")  # optional: append every stdin line here
# Where the per-spawn credential-routing record goes.
#
# The engine deliberately does NOT pass its own environment to children (F015): it clears
# the env and re-adds a short allowlist, so a dump path exported to the ENGINE container
# cannot reach this child at all. The harness therefore has to know its own default. An
# explicit WHEEL_FAKE_ENV_DUMP still wins for anything spawned directly by a test.
DEFAULT_ENV_DUMP = "/data/wheel-fake-env.jsonl"


ENV_DUMP = fake_opt("WHEEL_FAKE_ENV_DUMP", "env_dump") or (
    DEFAULT_ENV_DUMP if os.path.isdir(os.path.dirname(DEFAULT_ENV_DUMP)) else None)
# sha256 digests a test wants located by NAME in this child's environment.
# Names are the answer; values never leave this process.
SENTINELS = [d for d in (fake_opt("WHEEL_FAKE_ENV_SENTINELS", "env_sentinels") or "").split(",") if d]  # optional: append one JSON record per spawn

def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"

def emit(obj):
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    sys.stdout.flush()

def die(msg, code=1):
    sys.stderr.write("fake-claude: " + msg + "\n")
    sys.stderr.flush()
    sys.exit(code)

# ---------------------------------------------------------------- arg parsing
def auth_login():
    """`claude auth login --claudeai` — the paste-code half of the OAuth flow (§4).

    The engine spawns this, reads stdout until an authorize URL appears, then holds the
    child open and writes the user's pasted code to its stdin. The shape matters: the
    engine's URL scanner must pick the URL out of surrounding prose, so print prose too.

    Blocking on stdin forever is deliberate — an ABANDONED login is exactly a child sitting
    here, and that is the process leak the engine's reaping is supposed to prevent.
    """
    if fake_opt("WHEEL_FAKE_LOGIN_NO_URL", "login_no_url") == "1":
        die("login failed before it could print a url", 1)

    state = fake_opt("WHEEL_FAKE_LOGIN_STATE", "login_state") or uuid.uuid4().hex[:12]
    url = ("https://claude.com/cai/oauth/authorize?code=true&client_id=fake-client"
           "&response_type=code&state=%s&code_challenge=%s&code_challenge_method=S256"
           % (state, uuid.uuid4().hex))
    sys.stdout.write("Browser didn't open? Use the url below to sign in:\n\n")
    sys.stdout.write(url + "\n\n")
    sys.stdout.write("Paste code here if prompted > ")
    sys.stdout.flush()

    line = sys.stdin.readline()
    if not line:
        die("login aborted: stdin closed before a code arrived", 1)
    want = fake_opt("WHEEL_FAKE_LOGIN_CODE", "login_code") or "fake-auth-code"
    if line.strip() != want:
        die("OAuth error: invalid code", 1)

    cfg = os.environ.get("CLAUDE_CONFIG_DIR")
    if cfg:
        try:
            os.makedirs(cfg, exist_ok=True)
            cred = os.path.join(cfg, ".credentials.json")
            with open(cred, "w") as fh:
                json.dump({"claudeAiOauth": {"accessToken": "sk-ant-oat-fake-%s" % state,
                                             "account": {"email_address": "qa@wheel.test"}}}, fh)
            os.chmod(cred, 0o600)
        except OSError as e:
            if not ENV_DUMP:
                # Nobody asked for this dump by name; a suite that needs it asserts on its
                # contents and fails there, so do not take down an unrelated spawn.
                return
            die("could not write credentials: %s" % e, 1)
    sys.stdout.write("\nLogin successful.\n")
    sys.stdout.flush()
    sys.exit(0)


def parse_args(argv):
    a = {
        "print": False, "input_format": "text", "output_format": "text",
        "verbose": False, "model": None, "system_prompt_append": None, "system_prompt": None,
        "resume": None, "prompt": None, "mcp_config": None, "cwd": os.getcwd(),
        "permission_mode": "default",
    }
    i = 0
    while i < len(argv):
        t = argv[i]
        if t in ("-p", "--print"):                 a["print"] = True
        elif t == "--verbose":                     a["verbose"] = True
        elif t == "--input-format":                i += 1; a["input_format"] = argv[i]
        elif t == "--output-format":               i += 1; a["output_format"] = argv[i]
        elif t == "--model":                       i += 1; a["model"] = argv[i]
        elif t == "--append-system-prompt":        i += 1; a["system_prompt_append"] = argv[i]
        elif t == "--append-system-prompt-file":   i += 1; a["system_prompt_append"] = _readfile(argv[i])
        elif t == "--system-prompt":               i += 1; a["system_prompt"] = argv[i]
        elif t == "--system-prompt-file":          i += 1; a["system_prompt"] = _readfile(argv[i])
        elif t == "--resume":                      i += 1; a["resume"] = argv[i]
        elif t == "--permission-mode":             i += 1; a["permission_mode"] = argv[i]
        elif t in ("--mcp-config", "--mcp-servers"): i += 1; a["mcp_config"] = argv[i]
        elif t == "--version":                     print(VERSION); sys.exit(0)
        elif t in ("-h", "--help"):                print("fake-claude: see qa/harness/README.md"); sys.exit(0)
        elif t.startswith("-"):
            # Unknown flags are TOLERATED (real CLI has many); record for assertions.
            if i + 1 < len(argv) and not argv[i + 1].startswith("-"):
                i += 1
        else:
            a["prompt"] = t
        i += 1
    return a

def composed_system_prompt(a):
    """Everything the engine handed us as system context, concatenated in order."""
    parts = [p for p in (a.get("system_prompt"), a.get("system_prompt_append")) if p]
    return "\n".join(parts) if parts else None

def _readfile(p):
    try:
        with open(p) as f: return f.read()
    except OSError: return None

# ---------------------------------------------------------------- auth gate
ROOT_REFUSAL = ("--dangerously-skip-permissions cannot be used with root/sudo "
                "privileges for security reasons")

def root_refusal_guard(a):
    """Reproduce the real CLI's refusal of bypassPermissions when running as root.

    Verified live by SDK: exit 1, EMPTY stdout, that exact stderr. Byte-identical in
    exit code to an unauthenticated CLI, so a supervisor that infers needs_auth from
    the exit code alone reports needs_auth forever for what is really a privilege
    misconfiguration. WHEEL_FAKE_ROOT=1 forces it without needing a root container.
    """
    forced = fake_opt("WHEEL_FAKE_ROOT", "root") == "1"
    is_root = hasattr(os, "geteuid") and os.geteuid() == 0
    if (forced or is_root) and a.get("permission_mode") == "bypassPermissions":
        die(ROOT_REFUSAL, 1)

# ------------------------------------------------------------- credential routing
# The env vars the engine may use to hand a credential to the child. They are NOT
# interchangeable: `claude setup-token` mints an sk-ant-oat… token that must arrive as
# CLAUDE_CODE_OAUTH_TOKEN, and an sk-ant-api… key must arrive as ANTHROPIC_API_KEY.
# Swapping them fails at request time looking exactly like a bad credential, so the
# failure surfaces as needs_auth and points at the user rather than at the routing.
CRED_VARS = ("ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN", "ANTHROPIC_AUTH_TOKEN",
             "CLAUDE_API_KEY", "OPENAI_API_KEY", "CODEX_API_KEY")
CONFIG_VARS = ("CLAUDE_CONFIG_DIR", "CODEX_HOME", "WHEEL_TOKEN_FILE", "WHEEL_TOKEN", "IS_SANDBOX")

def credential_class(value):
    """Name the KIND of credential without ever revealing it."""
    if value.startswith("sk-ant-oat"):
        return "oauth_token"
    if value.startswith("sk-ant-api"):
        return "api_key"
    if value.startswith("sk-ant-"):
        return "anthropic_unknown"
    if value.startswith("sk-"):
        return "openai_style"
    return "opaque"

def sentinel_hits():
    """Which environment variables carry a value the test already knows the digest of.

    A leak check that only looks at variable NAMES passes when the same secret arrives
    under a different name, which is the shape a refactor produces. Hashing every value
    and reporting the names that match answers "did this secret reach the child, under
    any name at all" -- and the same mechanism proves itself, because a test supplies
    the digest of a secret that is SUPPOSED to arrive alongside the ones that are not.
    """
    if not SENTINELS:
        return {}
    want = set(SENTINELS)
    hits = {}
    for name, value in os.environ.items():
        d = hashlib.sha256(value.encode()).hexdigest()
        if d in want:
            hits[name] = d
    return hits


def env_dump(a):
    """Append one record describing HOW this spawn was credentialed.

    Values are never written — only their length, sha256 and prefix class — so a test can
    assert `the sk-ant-oat token arrived as CLAUDE_CODE_OAUTH_TOKEN and nowhere else`
    without a secret ever reaching disk. One record per spawn (JSONL), because idle parking
    means an agent is spawned many times and each spawn is a separate routing decision.
    """
    if not ENV_DUMP:
        return
    creds = {}
    for name in CRED_VARS:
        v = os.environ.get(name)
        if v is None:
            continue
        creds[name] = {"bytes": len(v.encode()), "sha256": hashlib.sha256(v.encode()).hexdigest(),
                       "class": credential_class(v)}
    # Vault keys are exported under names the board chooses, so a fixed list cannot cover
    # them. Names are not secret and values are; record every NAME, and a sha256 only for
    # the names the test asks about (WHEEL_FAKE_ENV_DUMP_KEYS=a,b,c). That is enough to
    # prove "the child received exactly this secret under exactly this name" without the
    # secret existing anywhere a later grep could find it.
    asked = [k for k in (fake_opt("WHEEL_FAKE_ENV_DUMP_KEYS", "env_dump_keys") or "").split(",") if k]
    digests = {}
    for name in asked:
        v = os.environ.get(name)
        digests[name] = None if v is None else {
            "bytes": len(v.encode()), "sha256": hashlib.sha256(v.encode()).hexdigest()}

    rec = {"ts": now_iso(), "pid": os.getpid(), "argv0": os.path.basename(sys.argv[0]),
           "uid": os.geteuid() if hasattr(os, "geteuid") else None,
           "permission_mode": a.get("permission_mode"), "resume": a.get("resume"),
           "credentials": creds,
           "credential_vars_set": sorted(creds),
           "env_names": sorted(os.environ),
           # sha256 of EVERY value, keyed by name. Names alone cannot answer "did the
           # engine's own secret reach this child?", because a leak under a DIFFERENT
           # variable name passes a name check. Comparing digests catches the rename. No
           # value is ever written; this dump only exists inside the throwaway test
           # container, and only when WHEEL_FAKE_ENV_DUMP is set.
           "env_digests": {k: hashlib.sha256(v.encode()).hexdigest()
                           for k, v in os.environ.items()},
           "sentinel_hits": sentinel_hits(),
           "digests": digests,
           "config": {k: os.environ.get(k) for k in CONFIG_VARS if os.environ.get(k) is not None},
           "argv": sys.argv[1:]}
    try:
        with open(ENV_DUMP, "a") as fh:
            fh.write(json.dumps(rec, separators=(",", ":")) + "\n")
    except OSError as e:
        # A dump we cannot write must be loud: a silently missing record reads as
        # "no credential was set", which is the exact wrong answer.
        die("cannot write WHEEL_FAKE_ENV_DUMP %s: %s" % (ENV_DUMP, e), 2)

def auth_state():
    """Mirrors the engine's needs_auth flow. WHEEL_FAKE_AUTH=needs_auth|ok."""
    st = fake_opt("WHEEL_FAKE_AUTH", "auth") or "ok"
    if st == "ok" and not (os.environ.get("ANTHROPIC_API_KEY") or os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")):
        # Default fake is authenticated even without creds; opt in to strictness.
        if fake_opt("WHEEL_FAKE_STRICT_AUTH", "strict_auth"):
            return "needs_auth"
    return st

# ---------------------------------------------------------------- directives
DIRECTIVE = re.compile(r"<<FAKE:([A-Z_]+)(?:=([^>]*))?>>")

def directives(text):
    return {m.group(1): (m.group(2) if m.group(2) is not None else "") for m in DIRECTIVE.finditer(text or "")}

# ---------------------------------------------------------------- input
def text_of(msg):
    """Extract plain text from a stream-json user turn (string or content blocks)."""
    m = msg.get("message", msg)
    c = m.get("content", "")
    if isinstance(c, str):
        return c
    out = []
    for b in c or []:
        if isinstance(b, dict) and b.get("type") == "text":
            out.append(b.get("text", ""))
        elif isinstance(b, str):
            out.append(b)
    return "\n".join(out)

def main():
    argv = sys.argv[1:]
    # Subcommand, not a flag: `auth login` never reaches the stream-json path.
    if argv[:2] == ["auth", "login"]:
        auth_login()
    a = parse_args(argv)
    session_id = a["resume"] or fake_opt("WHEEL_FAKE_SESSION_ID", "session_id") or str(uuid.uuid4())
    model = a["model"] or "claude-fake-1"
    stream = a["output_format"] == "stream-json"

    # Before every exit path: a spawn that dies on the root trap or on needs_auth is
    # exactly the spawn whose credential routing a test most wants to inspect.
    env_dump(a)

    # SDK auth spike: --permission-mode bypassPermissions is REFUSED when the child runs as
    # root. Exit 1 + EMPTY stdout + this exact stderr — byte-identical to "not logged in".
    # The engine MUST classify this as `error`, never `needs_auth`, and must never infer
    # needs_auth from the exit code alone.
    if fake_opt("WHEEL_FAKE_ROOT_REFUSAL", "root_refusal") == "1" or (
            a["permission_mode"] == "bypassPermissions" and fake_opt("WHEEL_FAKE_UID", "uid") == "0"):
        die("--dangerously-skip-permissions cannot be used with root/sudo privileges for security reasons", 1)

    root_refusal_guard(a)

    if auth_state() == "needs_auth":
        # Real CLI exits non-zero with a login prompt on stderr; engine maps -> needs_auth.
        die("Invalid API key · Please run /login", 1)

    if stream:
        emit({"type": "system", "subtype": "init", "cwd": a["cwd"], "session_id": session_id,
              "tools": ["Bash", "Read", "Write", "Edit"], "mcp_servers": _mcp_servers(a),
              "model": model, "permissionMode": a["permission_mode"], "slash_commands": [],
              "apiKeySource": "none", "claude_code_version": VERSION, "output_style": "default",
              "agents": [], "skills": [], "uuid": str(uuid.uuid4()),
              # Wheel contract: the FIRST event carries the full composed system prompt verbatim,
              # so tests can assert ctx-node injection + system_prompt actually reached the child.
              "system_prompt": composed_system_prompt(a),
              "_fake_system_prompt": composed_system_prompt(a)})

    turn = 0
    if a["input_format"] == "stream-json":
        for line in sys.stdin:
            line = line.strip()
            if not line:
                continue
            _record(line)
            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                # Real CLI errors on malformed input; engine must surface it.
                die("Invalid JSON on stdin: " + line[:120], 2)
            if msg.get("type") not in (None, "user"):
                continue  # tolerate control frames
            turn += 1
            respond(text_of(msg), turn, session_id, model, stream)
    else:
        prompt = a["prompt"] if a["prompt"] is not None else sys.stdin.read()
        _record(prompt)
        turn = 1
        respond(prompt, turn, session_id, model, stream)

    sys.exit(0)

def _mcp_servers(a):
    if not a["mcp_config"]:
        return []
    try:
        cfg = json.loads(a["mcp_config"]) if a["mcp_config"].lstrip().startswith("{") else json.load(open(a["mcp_config"]))
        return [{"name": k, "status": "connected"} for k in (cfg.get("mcpServers") or cfg).keys()]
    except Exception:
        return []

def _record(line):
    if TRANSCRIPT:
        try:
            with open(TRANSCRIPT, "a") as f: f.write(line.rstrip("\n") + "\n")
        except OSError: pass

# ---------------------------------------------------------------- response
_SCRIPT = None

def script_turn(turn):
    """Canned turn `turn` (1-based) from WHEEL_FAKE_SCRIPT, or None.

    Each line is one JSON object: {"reply","is_error","sleep","exit","stderr","events":[raw]}.
    Running past the end of the script is an ERROR, not a silent fallthrough - a test that
    sends more turns than it scripted is a broken test and must fail loudly.
    """
    global _SCRIPT
    if not SCRIPT_PATH:
        return None
    if _SCRIPT is None:
        _SCRIPT = []
        try:
            with open(SCRIPT_PATH) as f:
                for ln in f:
                    ln = ln.strip()
                    if ln and not ln.startswith("#"):
                        _SCRIPT.append(json.loads(ln))
        except OSError as e:
            die("cannot read WHEEL_FAKE_SCRIPT %s: %s" % (SCRIPT_PATH, e), 2)
        except json.JSONDecodeError as e:
            die("malformed WHEEL_FAKE_SCRIPT %s: %s" % (SCRIPT_PATH, e), 2)
    if turn - 1 < len(_SCRIPT):
        return _SCRIPT[turn - 1]
    die("WHEEL_FAKE_SCRIPT exhausted: got turn %d, script has %d" % (turn, len(_SCRIPT)), 3)

def run_shell(b64):
    """`<<FAKE:SH_B64=...>>` — run a real command as this child, and report it.

    This exists for the wheel-on-wheel acceptance test, where the thing being proved is
    that a sandbox is a usable development environment: the toolchain is present, and a
    credential the engine exported from a vault actually works. The command runs as THIS
    process's child, so it inherits exactly the environment the engine composed — the
    uid, the vault exports, PATH — which is the whole point. Driving it from outside with
    `docker exec` would test a different environment than the one agents get.

    Base64 because the directive grammar stops at '>', and any real command has redirects.

    It runs real commands, so it must never exist outside the test image; `make
    image-verify-prod` asserts nothing shadows `claude` in the production image, which is
    what keeps this file out of it.
    """
    try:
        cmd = base64.b64decode(b64).decode()
    except Exception as e:
        return "SH_B64 is not base64: %s" % e
    try:
        p = subprocess.run(["/bin/sh", "-c", cmd], capture_output=True, text=True,
                           timeout=int(os.environ.get("WHEEL_FAKE_SH_TIMEOUT") or 1800))
    except subprocess.TimeoutExpired:
        return "exit=timeout"
    # Tail, not head: a compiler says what went wrong at the end.
    return "exit=%d\nSTDOUT:\n%s\nSTDERR:\n%s" % (
        p.returncode, p.stdout[-6000:], p.stderr[-6000:])


def respond(user_text, turn, session_id, model, stream):
    d = directives(user_text)
    if "SH_B64" in d:
        d["REPLY"] = run_shell(d["SH_B64"])
    canned = script_turn(turn)
    if canned:
        # Canned turns take precedence; directives still work for anything unspecified.
        for k, flag in (("sleep", "SLEEP"), ("exit", "EXIT"), ("stderr", "STDERR"), ("reply", "REPLY")):
            if k in canned and canned[k] is not None:
                d[flag] = str(canned[k])
        if canned.get("is_error"):
            d["ERROR"] = str(canned.get("error") or canned.get("reply") or "fake error")
        for raw in canned.get("events") or []:
            if stream:
                emit(raw)

    if "SLEEP" in d:
        time.sleep(float(d["SLEEP"] or 1))
    if "EXIT" in d:
        sys.exit(int(d["EXIT"] or 1))
    if "CRASH" in d:
        os.kill(os.getpid(), signal.SIGKILL)
    if "STDERR" in d:
        sys.stderr.write((d["STDERR"] or "fake stderr") + "\n"); sys.stderr.flush()
    if "GARBAGE" in d:
        # Emit a non-JSON line: the engine MUST NOT die on this (ENG-log-garbage).
        sys.stdout.write("this is not json\n"); sys.stdout.flush()

    # Deterministic reply that ECHOES what we were given.
    if "REPLY" in d:
        reply = d["REPLY"]
    else:
        reply = "[fake-claude] turn %d: %s" % (turn, (user_text or "").strip())
    reply = DIRECTIVE.sub("", reply).strip()

    msg_id = "msg_fake_" + hashlib.sha256(("%s|%d" % (session_id, turn)).encode()).hexdigest()[:16]
    base_usage = {"input_tokens": max(1, len(user_text or "") // 4), "output_tokens": max(1, len(reply) // 4),
                  "cache_creation_input_tokens": 0, "cache_read_input_tokens": 0, "service_tier": "standard"}

    if stream:
        if "NOISE" in d:
            # Unknown/extra event types the real CLI emits. Engine must ignore unknown types.
            emit({"type": "rate_limit_event", "rate_limit_info": {"status": "allowed"}, "session_id": session_id})
            emit({"type": "system", "subtype": "thinking_tokens", "estimated_tokens": 42, "session_id": session_id})
        if "TOOL" in d:
            tu_id = "toolu_fake_" + hashlib.sha256(reply.encode()).hexdigest()[:12]
            emit({"type": "assistant", "message": {"model": model, "id": msg_id, "type": "message", "role": "assistant",
                  "content": [{"type": "tool_use", "id": tu_id, "name": "Bash", "input": {"command": d["TOOL"] or "true"}}],
                  "stop_reason": None, "usage": base_usage},
                  "parent_tool_use_id": None, "session_id": session_id, "uuid": str(uuid.uuid4()), "timestamp": now_iso()})
            emit({"type": "user", "message": {"role": "user", "content": [
                  {"type": "tool_result", "tool_use_id": tu_id, "content": "ok"}]},
                  "parent_tool_use_id": None, "session_id": session_id, "uuid": str(uuid.uuid4()), "timestamp": now_iso()})
        emit({"type": "assistant", "message": {"model": model, "id": msg_id, "type": "message", "role": "assistant",
              "content": [{"type": "text", "text": reply}], "stop_reason": None, "stop_sequence": None,
              "usage": base_usage},
              "parent_tool_use_id": None, "session_id": session_id, "uuid": str(uuid.uuid4()),
              "timestamp": now_iso(), "request_id": "req_fake_%d" % turn})

    is_error = "ERROR" in d
    result = {"type": "result", "subtype": "error_during_execution" if is_error else "success",
              "is_error": is_error, "result": (d.get("ERROR") or "fake error") if is_error else reply,
              "session_id": session_id, "num_turns": turn, "duration_ms": 1, "duration_api_ms": 1,
              "total_cost_usd": 0.0, "usage": base_usage, "permission_denials": [],
              "uuid": str(uuid.uuid4())}
    if stream:
        emit(result)
    elif (fake_opt("WHEEL_FAKE_OUTPUT", "output") or "") == "json":
        emit(result)
    else:
        sys.stdout.write(reply + "\n"); sys.stdout.flush()

def _quiet_broken_pipe():
    """Engine closing our stdout on stop must not print a Python traceback."""
    try:
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        try:
            os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
        except OSError:
            pass

if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        _quiet_broken_pipe(); sys.exit(0)
    except KeyboardInterrupt:
        _quiet_broken_pipe(); sys.exit(130)
    finally:
        _quiet_broken_pipe()
