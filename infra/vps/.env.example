# Copy to infra/vps/.env, then `chmod 600 .env`. Never commit it (.gitignore covers it).
# Set exactly ONE of WHEEL_DOMAIN and WHEEL_PUBLIC_HOST.

# HTTPS with an automatic Let's Encrypt certificate. The domain's A record must point at this server
# and ports 80 and 443 must be open before `docker compose up`.
WHEEL_DOMAIN=wheel.example.com
# Optional. Let's Encrypt uses it for account recovery.
ACME_EMAIL=

# Plain HTTP on port 80, for a server without a domain. Everything, passwords included, crosses the
# network in the clear. Prefer the SSH-tunnel variant in README.md.
# WHEEL_PUBLIC_HOST=203.0.113.5

# 1 = a certificate from Caddy's own CA instead of Let's Encrypt (LAN, or a domain with no public DNS).
# Browsers will not trust it until you install Caddy's root certificate.
WHEEL_TLS_INTERNAL=

# `closed` (default): nobody can sign up. `open`: anyone who can reach the server can create an
# account and run agents on your machine. Never leave it open on a public server.
WHEEL_SIGNUP=closed

# The internal network. Change both together only if the subnet collides with one you already use.
# Caddy's address here is the single proxy wheeld and the web app trust for X-Forwarded-For.
# WHEEL_EDGE_SUBNET=10.231.8.0/24
# WHEEL_CADDY_IP=10.231.8.10
