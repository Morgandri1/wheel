# Copy to infra/vps/.env, then `chmod 600 .env`. Never commit it (.gitignore covers it).
# Only ./deploy.sh and ./rehearse.sh read this file directly — they compute every other setting
# compose.yml needs (PUBLIC_BASE_URL, WHEEL_ALLOWED_HOSTS, WHEEL_TRUSTED_PROXIES, COMPOSE_PROFILES,
# ...) from what is here. Do not add those yourself, and never run `docker compose` against this
# file directly.

# Leave unset for TUNNEL MODE (the default): nothing is published to the network at all. Reach the
# board over `ssh -L 3000:127.0.0.1:3000 -L 8080:127.0.0.1:8080 <user>@<host>`. Good for a box with
# no domain yet, or one you only ever want to reach yourself.
#
# Set to a domain whose A record already points at this server for TLS MODE: Caddy starts,
# publishes 80 and 443, and gets an automatic Let's Encrypt certificate. There is no third mode
# that serves plain HTTP to the network — see preflight.sh and infra/vps/README.md for why.
WHEEL_DOMAIN=

# TLS mode only. Optional; Let's Encrypt uses it for account recovery.
ACME_EMAIL=

# TLS mode only. 1 = a certificate from Caddy's own CA instead of Let's Encrypt (a LAN, or a
# domain with no public DNS yet). Browsers will not trust it until you install Caddy's root
# certificate. infra/vps/rehearse.sh sets this itself; you do not need to for a real domain.
WHEEL_TLS_INTERNAL=

# `closed` (default): nobody can sign up. `open`: anyone who can reach the server can create an
# account and run agents on your machine. Never leave it open on a public server.
WHEEL_SIGNUP=closed

# TLS mode's internal network. Change both together only if the subnet collides with one you
# already use. Caddy's address here is the single proxy wheeld and the web app trust for
# X-Forwarded-For.
# WHEEL_EDGE_SUBNET=10.231.8.0/24
# WHEEL_CADDY_IP=10.231.8.10

# The loopback ports wheeld and the web app publish, in every mode. Change these only if something
# else on the server already uses 8080 or 3000.
# WHEEL_WHEELD_PORT=8080
# WHEEL_WEB_PORT=3000
