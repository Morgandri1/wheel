# shellcheck shell=sh
#
# The toolchain Docker used to bundle. Native means the host supplies it, so it is pinned here —
# one file to bump, sourced by install.sh and re-checked by wheel-preflight on every service start.
#
# THE PIN AND THE FLOOR ARE SEPARATE ON PURPOSE.
#
# The pin is for reproducibility: two boxes installed a month apart should run the same CLI. The
# floor is the product requirement, and it is asserted against what `claude --version` ACTUALLY
# PRINTS — never against what npm was asked to install. An npm cache, a pre-existing global
# install, or an upgrade that half-failed all produce a box where the pin says one thing and the
# binary on PATH is another, and the failure that follows is an OAuth refresh that stops working in
# a week rather than an install that fails now.
#
# A gate (infra/tests/native-toolchain.test.sh) asserts WHEEL_CLAUDE_VERSION is not below
# WHEEL_CLAUDE_MIN, so a careless bump cannot drop a box under the OAuth requirement.

# web/package.json's engines.node is "22.x". A gate asserts these stay equal.
WHEEL_NODE_MAJOR=22

# Must equal web/package.json's "packageManager". A gate asserts that too: the installer building
# the board with a different pnpm than the repo declares is how a lockfile resolves differently on
# a server than it does in CI.
WHEEL_PNPM_VERSION=9.15.4

# PR #64's headless OAuth refresh needs >= 2.1.269. This is the floor, and it is the reason this
# file exists at all.
WHEEL_CLAUDE_MIN=2.1.269
WHEEL_CLAUDE_VERSION=2.1.269

WHEEL_CODEX_VERSION=0.154.0
