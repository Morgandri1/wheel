#
# Installed by infra/vps/install.sh. Settings: /etc/wheel/wheeld.env (managed by install.sh) and
# /etc/wheel/wheeld.local.env (yours; read second, so it wins).

[Unit]
Description=Wheel daemon: API, sandbox host and per-project engines
Documentation=https://github.com/Morgandri1/wheel/blob/main/infra/vps/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wheel
Group=wheel
EnvironmentFile=/etc/wheel/wheeld.env
EnvironmentFile=-/etc/wheel/wheeld.local.env
ExecStart=/opt/wheel/bin/wheeld --data-dir /var/lib/wheel --bind 127.0.0.1:8080
# mixed: SIGTERM goes to wheeld alone, which drains in-flight turns (~28s) and stops every agent's
# own process group itself — sending SIGTERM to the whole cgroup directly (control-group) would
# race wheeld's own orchestrated shutdown instead of letting it run. Whatever is left in the cgroup
# after the timeout is killed. TimeoutStopSec gives real margin over the ~28s drain, not the bare
# minimum, since the last couple of seconds are exactly where a slow shutdown gets killed early.
KillMode=mixed
TimeoutStopSec=35
# Also the auto-update hook: WHEEL_UPDATE_RESTART=exit swaps the binary and exits 75.
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/wheel
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
