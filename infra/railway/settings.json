      "dockerfilePath": "docker/Dockerfile.host",
      "numReplicas": 1,
      "healthcheckPath": "/healthz",
      "healthcheckTimeout": 30,
      "restartPolicyType": "ON_FAILURE",
      "restartPolicyMaxRetries": 10,
      "watchPatterns": [
        "crates/wheel-host/**",
        "crates/wheel-engine/**",
        "crates/wheel-cli/**",
        "crates/wheel-core/**",
        "Cargo.toml",
        "Cargo.lock",
        "docker/Dockerfile.host",
        "docker/entrypoint.sh"
