# The single Wheel image: engine + cli + host, plus the agent harnesses.
#
# One image, two roles (WHEEL_ROLE, §4b): `engine` is what the docker sandbox
# backend runs per project, `host` is the sandbox supervisor. Building both from
# one tree means the engine the host launches is always the engine it was built
# against.

# --- build ------------------------------------------------------------------
FROM rust:1-slim-bookworm AS build
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends \
        pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
# All three binaries are required. `wheel-host` was once optional — built with `|| true` and
# copied with a glob — from when API's crate did not exist yet. That combination meant a
# wheel-host COMPILE ERROR produced a perfectly good image with no host binary in it, and the
# failure only surfaced in production as a crash loop. It cost an outage. Build it like the others.
RUN cargo build --release --bin wheel-engine \
    && cargo build --release --bin wheel \
    && cargo build --release --bin wheel-host

# --- runtime ----------------------------------------------------------------
FROM debian:bookworm-slim

# node is required by the claude CLI (engines: node >= 22) and by `ts`/`js`
# script nodes; python3 backs `python` script nodes AND the QA fake harness.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git python3 python3-venv procps \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm i -g @anthropic-ai/claude-code @openai/codex \
    && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# --- dev toolchain ----------------------------------------------------------
# Wheel is meant to build Wheel: an agent inside a sandbox needs the same tools
# a developer has, or "wheel on wheel" means an agent that can read the repo and
# not compile it.
#
# cc/pkg-config/libssl are not optional extras here -- rusqlite builds bundled
# sqlite and ring builds its own asm, so without a C toolchain `cargo build`
# fails deep in a dependency with an error that reads like a Rust problem.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential pkg-config libssl-dev make \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
         -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
         > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && npm i -g pnpm && npm cache clean --force \
    && rm -rf /var/lib/apt/lists/*

# The toolchain is installed ONCE and shared read-only; only the per-project
# cache is private (CARGO_HOME, set per project at spawn -- see the supervisor).
#
# Deliberately not a RUSTUP_HOME per project: a toolchain is ~1 GB and immutable,
# so a copy per project would cost gigabytes to isolate bytes that are identical
# and contain nothing of the tenant's. What IS per-tenant -- fetched crates, the
# registry index, build output -- lives under CARGO_HOME and is private.
ENV RUSTUP_HOME=/opt/rust/rustup \
    CARGO_HOME=/opt/rust/cargo \
    PATH=/opt/rust/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain stable \
          --component clippy --component rustfmt \
    && chmod -R a+rX /opt/rust

# QA's fake harness is a python3 script, and script nodes need python3, so a
# missing interpreter would fail at agent-run time rather than at build time.
# Assert it here instead.
RUN python3 -c "import sys; assert sys.version_info[0] == 3" \
    && node --version && claude --version && codex --version \
    && git --version && gh --version && make --version | head -1 \
    && pnpm --version && cargo --version && rustc --version \
    && cargo clippy --version && cargo fmt --version && cc --version | head -1

# Agents run NON-ROOT. `--permission-mode bypassPermissions` is refused as root
# with exit 1 and EMPTY stdout — indistinguishable from "not logged in" — so
# running as root would make every agent look permanently unauthenticated.
# IS_SANDBOX=1 is belt and braces for the same guard.
RUN useradd --create-home --uid 10001 --shell /bin/bash agent
ENV IS_SANDBOX=1

COPY --from=build /src/target/release/wheel-engine /usr/local/bin/wheel-engine
COPY --from=build /src/target/release/wheel /usr/local/bin/wheel
COPY --from=build /src/target/release/wheel-host /usr/local/bin/wheel-host

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh \
    && test -x /usr/local/bin/wheel && /usr/local/bin/wheel --help >/dev/null \
    && test -x /usr/local/bin/wheel-host && test -x /usr/local/bin/wheel-engine

RUN mkdir -p /data && chown agent:agent /data
# No `VOLUME ["/data"]`: Railway rejects the directive outright ("docker VOLUME is not supported,
# use Railway Volumes") and fails the build. Nothing depended on it — compose mounts a named
# volume at /data explicitly, and Railway attaches its own — so the declaration only ever created
# an anonymous volume when someone forgot to mount one.

ENV WHEEL_ROLE=engine \
    WHEEL_DATA_DIR=/data \
    WHEEL_LISTEN=tcp://0.0.0.0:7000 \
    WHEEL_LOG=json
EXPOSE 7000

# The image starts as root: the host role must setuid per project (§4b) and the
# entrypoint drops the engine role to the unprivileged `agent` uid via setpriv.
USER root

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
    CMD curl -fsS http://127.0.0.1:7000/healthz || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
