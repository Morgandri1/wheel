# wheel-web — the board, as a standalone Next server. It is the only thing a browser talks to;
# it reaches the API itself at WHEEL_API_URL, so the API can stay on a private network.
#
#   docker build -f docker/Dockerfile.web -t wheel-web .
#   docker run --rm -p 3000:3000 -e WHEEL_API_URL=http://api:8080 wheel-web
#
# Behind a TLS-terminating proxy, also set WHEEL_PUBLIC_ORIGIN=https://<domain>: the CSRF check
# compares Origin with it and it decides whether the session cookie is Secure. See web/DEPLOY.md.
#
# The build context is the repo root, like the other images. docker/Dockerfile.web.dockerignore
# (BuildKit reads it in place of the root .dockerignore, which excludes web/) narrows it to web/.

FROM node:22-bookworm-slim AS build
WORKDIR /web
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm install -g pnpm@9.15.4
COPY web/package.json web/pnpm-lock.yaml ./
# --prod=false: typescript is a devDependency, and without it Next never reads tsconfig's "@/*"
# alias and the build dies on "Module not found" — a path error that is really a missing package.
RUN pnpm install --frozen-lockfile --prod=false
COPY web/ ./
# The checks are the guard that this is a runnable server, not merely a finished build.
RUN WHEEL_STANDALONE=1 pnpm build \
    && test -f .next/standalone/server.js \
    && test -d .next/standalone/node_modules/ws \
    && test -d .next/static/chunks

FROM node:22-bookworm-slim
RUN groupadd --system --gid 10001 wheel \
    && useradd --system --uid 10001 --gid wheel --no-create-home wheel
WORKDIR /app
# HOSTNAME is set because Docker sets it to the container id, and Next's server binds to it.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0 \
    PORT=3000 \
    WHEEL_API_URL=http://127.0.0.1:8080 \
    WHEEL_AUTH_MODE=local
# Standalone output is a server plus the node_modules it traced. Static assets and public/ are
# not part of it — a CDN usually serves them — so they are copied beside it, or every chunk 404s
# and the page renders but never hydrates.
COPY --from=build --chown=wheel:wheel /web/.next/standalone ./
COPY --from=build --chown=wheel:wheel /web/.next/static ./.next/static
COPY --from=build --chown=wheel:wheel /web/public ./public
USER 10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:3000/version.json').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
CMD ["node", "server.js"]
