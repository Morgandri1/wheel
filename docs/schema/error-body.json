{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ErrorBody",
  "description": "The uniform error body used by both the host and the engine.",
  "type": "object",
  "required": [
    "error"
  ],
  "properties": {
    "error": {
      "$ref": "#/definitions/ErrorDetail"
    }
  },
  "definitions": {
    "ErrorDetail": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "description": "Stable machine-readable code, e.g. `wire_denied`, `not_found`.",
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
