{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Event",
  "description": "Events pushed to `/v1/events` subscribers.",
  "oneOf": [
    {
      "description": "An agent's runtime state changed.",
      "type": "object",
      "required": [
        "node_id",
        "state",
        "type"
      ],
      "properties": {
        "node_id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "$ref": "#/definitions/NodeState"
        },
        "type": {
          "type": "string",
          "enum": [
            "node.state"
          ]
        }
      }
    },
    {
      "description": "A message was created, delivered or acked.",
      "type": "object",
      "required": [
        "message",
        "type"
      ],
      "properties": {
        "message": {
          "$ref": "#/definitions/Message"
        },
        "type": {
          "type": "string",
          "enum": [
            "message"
          ]
        }
      }
    },
    {
      "description": "A line of agent output.",
      "type": "object",
      "required": [
        "line",
        "type"
      ],
      "properties": {
        "line": {
          "$ref": "#/definitions/LogLine"
        },
        "type": {
          "type": "string",
          "enum": [
            "log"
          ]
        }
      }
    },
    {
      "description": "Nodes or wires changed; clients should refetch `GET /v1/board`. Coarse on purpose — the board is small and this avoids a second mutation protocol that could drift from the REST one.",
      "type": "object",
      "required": [
        "at",
        "type"
      ],
      "properties": {
        "at": {
          "$ref": "#/definitions/Timestamp"
        },
        "type": {
          "type": "string",
          "enum": [
            "board.changed"
          ]
        }
      }
    },
    {
      "description": "A capability check failed.",
      "type": "object",
      "required": [
        "denial",
        "type"
      ],
      "properties": {
        "denial": {
          "$ref": "#/definitions/WireDenial"
        },
        "type": {
          "type": "string",
          "enum": [
            "wire.denied"
          ]
        }
      }
    }
  ],
  "definitions": {
    "AgentStatus": {
      "description": "Lifecycle of an agent node's child process.",
      "oneOf": [
        {
          "description": "No child process. The default, and where a node lands after `stop`.",
          "type": "string",
          "enum": [
            "stopped"
          ]
        },
        {
          "description": "Child spawned, harness not yet ready to accept a turn.",
          "type": "string",
          "enum": [
            "starting"
          ]
        },
        {
          "description": "The harness reports it has no usable credentials. Terminal until the operator completes `/v1/agents/:id/auth/*`.",
          "type": "string",
          "enum": [
            "needs_auth"
          ]
        },
        {
          "description": "Child is mid-turn (a message is being processed).",
          "type": "string",
          "enum": [
            "running"
          ]
        },
        {
          "description": "Child is alive and waiting for input.",
          "type": "string",
          "enum": [
            "idle"
          ]
        },
        {
          "description": "Child exited unexpectedly or the harness reported a fatal error; `last_error` carries the detail.",
          "type": "string",
          "enum": [
            "error"
          ]
        }
      ]
    },
    "LogLine": {
      "description": "One line of agent output. `seq` is monotonic per agent and is the cursor used by `GET /v1/agents/:id/log?since=<seq>`.",
      "type": "object",
      "required": [
        "at",
        "node_id",
        "seq",
        "stream",
        "text"
      ],
      "properties": {
        "at": {
          "$ref": "#/definitions/Timestamp"
        },
        "node_id": {
          "type": "string",
          "format": "uuid"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "stream": {
          "$ref": "#/definitions/LogStream"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "LogStream": {
      "description": "Where a log line came from.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        {
          "description": "Emitted by the engine itself (spawn, exit, session clear, ...).",
          "type": "string",
          "enum": [
            "engine"
          ]
        }
      ]
    },
    "Message": {
      "description": "A message row, persisted before any delivery is attempted.",
      "type": "object",
      "required": [
        "body",
        "bytes",
        "created_at",
        "from",
        "id",
        "sha256",
        "state",
        "to"
      ],
      "properties": {
        "body": {
          "type": "string"
        },
        "bytes": {
          "description": "Byte length of `body`.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "consumed_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "created_at": {
          "$ref": "#/definitions/Timestamp"
        },
        "delivered_at": {
          "anyOf": [
            {
              "$ref": "#/definitions/Timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "from": {
          "$ref": "#/definitions/MessageSender"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "last_error": {
          "description": "Why this message is still `queued`. Never a reason to truncate it (§3c#11).",
          "type": [
            "string",
            "null"
          ]
        },
        "reply_to": {
          "description": "Threading (§3c#9): the message this one replies to.",
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "sha256": {
          "description": "Lowercase hex SHA-256 of `body` as sent, so the sender can prove what arrived is what was sent (§3c#3).",
          "type": "string"
        },
        "state": {
          "$ref": "#/definitions/MessageState"
        },
        "to": {
          "description": "Target agent node id.",
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "MessageSender": {
      "description": "Who sent a message. The `type` rendered into the envelope comes from here and is **engine-generated** — a body can never forge it (§3c#5).",
      "oneOf": [
        {
          "description": "A board node. Only `agent`, `endpoint` and `script` nodes can send; [`MessageSender::sender_type`] is what appears in the envelope.",
          "type": "object",
          "required": [
            "id",
            "kind",
            "name",
            "type"
          ],
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "enum": [
                "node"
              ]
            },
            "name": {
              "$ref": "#/definitions/NodeName"
            },
            "type": {
              "$ref": "#/definitions/NodeType"
            }
          }
        },
        {
          "description": "The operator, via the UI chat box or `POST /v1/agents/:id/send`.",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "user"
              ]
            }
          }
        },
        {
          "description": "The engine itself (e.g. a delivery failure notice).",
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "system"
              ]
            }
          }
        }
      ]
    },
    "MessageState": {
      "description": "Delivery state (§3c#4). Strictly forward-moving.",
      "oneOf": [
        {
          "description": "Persisted, not yet written to a child's stdin (agent stopped, or an earlier message is still in flight).",
          "type": "string",
          "enum": [
            "queued"
          ]
        },
        {
          "description": "Written to the child's stdin.",
          "type": "string",
          "enum": [
            "delivered"
          ]
        },
        {
          "description": "The harness reported the turn containing it complete.",
          "type": "string",
          "enum": [
            "consumed"
          ]
        }
      ]
    },
    "NodeName": {
      "description": "A node's unique, addressable name. Reserved: user, wheel, system, engine.",
      "type": "string",
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-_]{0,62}$"
    },
    "NodeState": {
      "description": "`state` as reported next to a node on `GET /v1/board`. Only agent nodes currently carry state; the enum leaves room for others (e.g. table row counts) without a breaking change.",
      "oneOf": [
        {
          "description": "Observed state of an `agent` node.",
          "type": "object",
          "required": [
            "kind",
            "status"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "agent"
              ]
            },
            "last_activity": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "queued_messages": {
              "description": "Messages persisted but not yet delivered into the child.",
              "default": 0,
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "session_id": {
              "description": "The harness's own session identifier for the current session. Changes on every start and on every `ephemeral_context` clear.",
              "type": [
                "string",
                "null"
              ]
            },
            "status": {
              "$ref": "#/definitions/AgentStatus"
            }
          }
        }
      ]
    },
    "NodeType": {
      "description": "The eight node types.",
      "type": "string",
      "enum": [
        "agent",
        "ctx",
        "table",
        "endpoint",
        "script",
        "mcp",
        "vault",
        "chest"
      ]
    },
    "Timestamp": {
      "description": "RFC3339 UTC timestamp, e.g. 2026-09-05T00:21:00Z",
      "type": "string",
      "format": "date-time"
    },
    "WireDenial": {
      "description": "A denied capability check, surfaced so the UI can show *why* an agent's call failed and so red-team/QA can assert on it.",
      "type": "object",
      "required": [
        "at",
        "from",
        "reason",
        "required",
        "target"
      ],
      "properties": {
        "at": {
          "$ref": "#/definitions/Timestamp"
        },
        "from": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string"
        },
        "required": {
          "$ref": "#/definitions/WireType"
        },
        "target": {
          "description": "Target as the caller named it — may not resolve to a node at all.",
          "type": "string"
        }
      }
    },
    "WireType": {
      "description": "What a wire permits. Wires are directional and stored on the *source* node.",
      "oneOf": [
        {
          "description": "Read the target's data (`wheel read`, `table query`, `chest get|ls`, `secret get`, `run <script>`, MCP attachment).",
          "type": "string",
          "enum": [
            "read"
          ]
        },
        {
          "description": "Mutate the target's data. For `table` and `chest`, write **implies** read — see [`WireType::satisfies`].",
          "type": "string",
          "enum": [
            "write"
          ]
        },
        {
          "description": "Deliver a message to the target (agent→agent, endpoint→agent, script→agent) or, for `ctx`→`agent`, inject context into its prompt.",
          "type": "string",
          "enum": [
            "send"
          ]
        }
      ]
    }
  }
}
