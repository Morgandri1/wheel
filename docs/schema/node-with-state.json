{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NodeWithState",
  "description": "A node plus its observed state: `GET /v1/board` returns `{ ...node, state }`.\n\n`state` is always present and is **null for non-agent node types** — not omitted.",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "config",
        "type"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/AgentConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "agent"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "config",
        "type"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/CtxConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "ctx"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "config",
        "type"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/TableConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "table"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "config",
        "type"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/EndpointConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "endpoint"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "config",
        "type"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/ScriptConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "script"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "config",
        "type"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/McpConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "mcp"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "config",
        "type"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/VaultConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "vault"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "config",
        "type"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/ChestConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "chest"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "config",
        "type"
      ],
      "properties": {
        "config": {
          "$ref": "#/definitions/ToolConfig"
        },
        "type": {
          "type": "string",
          "enum": [
            "tool"
          ]
        }
      }
    }
  ],
  "required": [
    "id",
    "name",
    "position"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "$ref": "#/definitions/NodeName"
    },
    "position": {
      "$ref": "#/definitions/Position"
    },
    "state": {
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/NodeState"
        },
        {
          "type": "null"
        }
      ]
    },
    "wires": {
      "description": "OUTGOING wires only.",
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/Wire"
      }
    }
  },
  "definitions": {
    "AgentConfig": {
      "type": "object",
      "required": [
        "harness",
        "system_prompt"
      ],
      "properties": {
        "budget": {
          "description": "Spend ceiling. On reach, the engine stops the agent with `status: budget_exhausted`.",
          "anyOf": [
            {
              "$ref": "#/definitions/Budget"
            },
            {
              "type": "null"
            }
          ]
        },
        "ephemeral_context": {
          "description": "Clear the session after every completed turn, re-applying the system prompt and ctx injections, before draining the next queued message.",
          "default": false,
          "type": "boolean"
        },
        "harness": {
          "$ref": "#/definitions/Harness"
        },
        "idle_timeout_secs": {
          "description": "Stop the process after this long idle and resume the session on the next message (§3c#14 idle parking). `None` uses [`DEFAULT_IDLE_TIMEOUT_SECS`]; `Some(0)` disables parking.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        },
        "model": {
          "description": "Harness-specific model id. `None` = the CLI's own default.",
          "type": [
            "string",
            "null"
          ]
        },
        "run_on_startup": {
          "description": "Start this agent when the container starts.",
          "default": false,
          "type": "boolean"
        },
        "system_prompt": {
          "description": "Appended to the harness's own system prompt, then followed by the markdown of every `ctx` node wired `send` into this agent.",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "AgentStatus": {
      "description": "Lifecycle of an agent node's child process.",
      "oneOf": [
        {
          "description": "No child process. The default, and where a node lands after `stop`.",
          "type": "string",
          "enum": [
            "stopped"
          ]
        },
        {
          "description": "Child spawned, harness not yet ready to accept a turn.",
          "type": "string",
          "enum": [
            "starting"
          ]
        },
        {
          "description": "The harness reports it has no usable credentials. Terminal until the operator completes `/v1/agents/:id/auth/*`.",
          "type": "string",
          "enum": [
            "needs_auth"
          ]
        },
        {
          "description": "Child is mid-turn (a message is being processed).",
          "type": "string",
          "enum": [
            "running"
          ]
        },
        {
          "description": "Child is alive and waiting for input.",
          "type": "string",
          "enum": [
            "idle"
          ]
        },
        {
          "description": "Process stopped after `idle_timeout_secs` to save compute (§3c#14). The session id is retained and the next message resumes it transparently, so parking never loses context.",
          "type": "string",
          "enum": [
            "parked"
          ]
        },
        {
          "description": "Stopped because the agent's `budget` was reached. Requires operator action; the engine will not restart it on its own.",
          "type": "string",
          "enum": [
            "budget_exhausted"
          ]
        },
        {
          "description": "Child exited unexpectedly or the harness reported a fatal error; `last_error` carries the detail.",
          "type": "string",
          "enum": [
            "error"
          ]
        }
      ]
    },
    "Budget": {
      "description": "Per-agent spend ceiling (§3e). Either field may be set independently.",
      "type": "object",
      "properties": {
        "max_turns": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0.0
        },
        "max_usd": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "ChestConfig": {
      "description": "Chest has no configuration; its content lives on disk under `/data/chest/<node_id>/` and is indexed in sqlite.",
      "type": "object",
      "additionalProperties": false
    },
    "Column": {
      "type": "object",
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "description": "Validated with a sqlite-safe charset so it is safe to quote into DDL. Unlike a node name this may be `user`, `system`, ... — the node reserved-name list is about message addressing, not columns.",
          "allOf": [
            {
              "$ref": "#/definitions/Ident"
            }
          ]
        },
        "type": {
          "$ref": "#/definitions/ColumnType"
        }
      },
      "additionalProperties": false
    },
    "ColumnType": {
      "description": "Column type of a `table` node, mapped onto a sqlite storage class.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "text",
            "integer",
            "real",
            "blob"
          ]
        },
        {
          "description": "Stored as TEXT; the engine validates it parses as JSON on write.",
          "type": "string",
          "enum": [
            "json"
          ]
        }
      ]
    },
    "CtxConfig": {
      "type": "object",
      "required": [
        "markdown"
      ],
      "properties": {
        "markdown": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "EndpointAuth": {
      "description": "How an endpoint authenticates inbound public requests (§3, M2).\n\nInternally tagged so the two shapes are structurally distinct: `bearer` cannot exist without a `vault_ref`, and `none` cannot carry one.",
      "oneOf": [
        {
          "description": "Public. Anyone who can reach the ingress URL can call it.",
          "type": "object",
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "description": "Requires a bearer token matching the secret at `vault_ref`. Needs an `endpoint → vault (read)` wire; a mismatch is a 401 with no body.",
          "type": "object",
          "required": [
            "mode",
            "vault_ref"
          ],
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "bearer"
              ]
            },
            "vault_ref": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "EndpointConfig": {
      "type": "object",
      "required": [
        "method",
        "path",
        "response_mode"
      ],
      "properties": {
        "auth": {
          "default": {
            "mode": "none"
          },
          "allOf": [
            {
              "$ref": "#/definitions/EndpointAuth"
            }
          ]
        },
        "method": {
          "$ref": "#/definitions/HttpMethod"
        },
        "path": {
          "description": "Leading slash, no `..`. Validated by [`crate::validate::validate_endpoint_path`], and constrained in the exported schema so the static gate catches it too.",
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))/[^\\s?#]*$"
        },
        "response_mode": {
          "$ref": "#/definitions/ResponseMode"
        }
      },
      "additionalProperties": false
    },
    "Fill": {
      "description": "How one field is filled. `value`/`vault_ref` are meaningful only for their corresponding mode; [`crate::validate::validate_config`] enforces that.",
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "$ref": "#/definitions/FillMode"
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "vault_ref": {
          "description": "`<vault node name>/<key>`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "FillMode": {
      "description": "How a field is filled when the operation is called (§3d).",
      "oneOf": [
        {
          "description": "The agent supplies it; appears in the operation's input schema.",
          "type": "string",
          "enum": [
            "agent"
          ]
        },
        {
          "description": "A value the operator typed. Never shown to the agent.",
          "type": "string",
          "enum": [
            "static"
          ]
        },
        {
          "description": "Resolved at call time from a wired vault. Never shown to the agent and never returned by `/v1/board`.",
          "type": "string",
          "enum": [
            "vault"
          ]
        },
        {
          "description": "Omitted from the request entirely.",
          "type": "string",
          "enum": [
            "hidden"
          ]
        }
      ]
    },
    "Harness": {
      "description": "Which CLI backs an agent node.",
      "type": "string",
      "enum": [
        "claude",
        "codex"
      ]
    },
    "HttpMethod": {
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
      ]
    },
    "Ident": {
      "description": "A sqlite-safe identifier (table column name).",
      "type": "string",
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_]{0,62}$"
    },
    "McpConfig": {
      "description": "MCP server config, tagged by transport.\n\nModelled as an enum rather than a struct of optionals so that \"stdio requires command\", \"http requires url\" and \"never both\" are *structural* — they hold in the exported JSON Schema and in the Rust type, not only in a runtime check the API might forget to call. The JSON shape is unchanged: `{\"transport\":\"stdio\",\"command\":...}`.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "command",
            "transport"
          ],
          "properties": {
            "args": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "command": {
              "type": "string"
            },
            "env": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string"
              }
            },
            "transport": {
              "type": "string",
              "enum": [
                "stdio"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "transport",
            "url"
          ],
          "properties": {
            "env": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": {
                "type": "string"
              }
            },
            "transport": {
              "type": "string",
              "enum": [
                "http"
              ]
            },
            "url": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "NodeName": {
      "description": "A node's unique, addressable name. Reserved: user, wheel, system, engine.",
      "type": "string",
      "maxLength": 63,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-_]{0,62}$"
    },
    "NodeState": {
      "description": "`state` as reported next to a node on `GET /v1/board`. Only agent nodes currently carry state; the enum leaves room for others (e.g. table row counts) without a breaking change.",
      "oneOf": [
        {
          "description": "Observed state of an `agent` node.",
          "type": "object",
          "required": [
            "kind",
            "status"
          ],
          "properties": {
            "hosted_on": {
              "description": "Where this agent's process lives: `\"cloud\"`, a local runner id, or `None` for **unhosted** — a first-class alarming state, not an absence (§3e). An agent nobody can run is a broken agent and the UI says so.",
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "agent"
              ]
            },
            "last_activity": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_error": {
              "type": [
                "string",
                "null"
              ]
            },
            "queued_messages": {
              "description": "Messages persisted but not yet delivered into the child.",
              "default": 0,
              "type": "integer",
              "format": "uint32",
              "minimum": 0.0
            },
            "session_id": {
              "description": "The harness's own session identifier for the current session. Changes on every start and on every `ephemeral_context` clear.",
              "type": [
                "string",
                "null"
              ]
            },
            "spend": {
              "description": "Observed spend, from the harness's usage events. Drives `budget`.",
              "anyOf": [
                {
                  "$ref": "#/definitions/Spend"
                },
                {
                  "type": "null"
                }
              ]
            },
            "status": {
              "$ref": "#/definitions/AgentStatus"
            }
          }
        }
      ]
    },
    "ParamLocation": {
      "description": "Where a parameter goes in the HTTP request.",
      "type": "string",
      "enum": [
        "header",
        "path",
        "query",
        "cookie",
        "body"
      ]
    },
    "Position": {
      "description": "Board coordinates. Floats because the canvas pans/zooms continuously.",
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "format": "double"
        },
        "y": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "ResponseMode": {
      "description": "What an endpoint returns to the HTTP caller.",
      "oneOf": [
        {
          "description": "`202 {\"queued\": true}` as soon as the request is fanned out.",
          "type": "string",
          "enum": [
            "ack"
          ]
        },
        {
          "description": "Run the wired script synchronously and return its stdout as the body.",
          "type": "string",
          "enum": [
            "script"
          ]
        }
      ]
    },
    "ScriptConfig": {
      "type": "object",
      "required": [
        "language",
        "source"
      ],
      "properties": {
        "language": {
          "$ref": "#/definitions/ScriptLanguage"
        },
        "source": {
          "type": "string"
        },
        "timeout_secs": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "maximum": 300.0,
          "minimum": 1.0
        }
      },
      "additionalProperties": false
    },
    "ScriptLanguage": {
      "type": "string",
      "enum": [
        "python",
        "ts",
        "js"
      ]
    },
    "Spend": {
      "description": "Accumulated cost for an agent's current lifetime.",
      "type": "object",
      "properties": {
        "turns": {
          "default": 0,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "usd": {
          "default": 0.0,
          "type": "number",
          "format": "double"
        }
      }
    },
    "TableConfig": {
      "type": "object",
      "required": [
        "columns"
      ],
      "properties": {
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Column"
          }
        }
      },
      "additionalProperties": false
    },
    "Timestamp": {
      "description": "RFC3339 UTC timestamp, e.g. 2026-09-05T00:21:00Z",
      "type": "string",
      "format": "date-time"
    },
    "ToolConfig": {
      "type": "object",
      "required": [
        "base_url",
        "kind",
        "source"
      ],
      "properties": {
        "base_url": {
          "description": "Absolute `http(s)` origin every operation is resolved against.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ToolKind"
        },
        "operations": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolOperation"
          }
        },
        "source": {
          "$ref": "#/definitions/ToolSource"
        }
      },
      "additionalProperties": false
    },
    "ToolFormat": {
      "description": "The document format a tool node was imported from.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "openapi",
            "swagger2",
            "postman",
            "insomnia"
          ]
        },
        {
          "description": "Operations authored by hand in the UI rather than imported.",
          "type": "string",
          "enum": [
            "manual"
          ]
        }
      ]
    },
    "ToolKind": {
      "description": "What kind of tool a `tool` node is (§3d / §3e).",
      "oneOf": [
        {
          "description": "An imported HTTP spec the engine calls directly.",
          "type": "string",
          "enum": [
            "http"
          ]
        },
        {
          "description": "Project-scoped mail relay through the API (§3e, M3).",
          "type": "string",
          "enum": [
            "email"
          ]
        }
      ]
    },
    "ToolMethod": {
      "description": "Methods a tool operation may use. Deliberately a separate enum from [`crate::node::HttpMethod`]: `endpoint` nodes are contractually limited to GET/POST/PUT/DELETE (§3), while imported specs routinely contain PATCH and HEAD. Sharing one enum would silently widen the endpoint contract.",
      "type": "string",
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE",
        "HEAD",
        "OPTIONS"
      ]
    },
    "ToolOperation": {
      "description": "One callable operation. Exposed over MCP as `<tool name>__<id>`.",
      "type": "object",
      "required": [
        "id",
        "method",
        "path"
      ],
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "id": {
          "description": "Stable identifier, unique within the node. Charset is restricted because it is concatenated into an MCP tool name.",
          "type": "string"
        },
        "method": {
          "$ref": "#/definitions/ToolMethod"
        },
        "params": {
          "default": [],
          "type": "array",
          "items": {
            "$ref": "#/definitions/ToolParam"
          }
        },
        "path": {
          "description": "Path template relative to `base_url`, e.g. `/users/{id}`.",
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ToolParam": {
      "type": "object",
      "required": [
        "location",
        "name"
      ],
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "fill": {
          "default": {
            "mode": "agent"
          },
          "allOf": [
            {
              "$ref": "#/definitions/Fill"
            }
          ]
        },
        "location": {
          "$ref": "#/definitions/ParamLocation"
        },
        "name": {
          "type": "string"
        },
        "required": {
          "default": false,
          "type": "boolean"
        },
        "schema": {
          "description": "JSON Schema fragment for this field, used to build the MCP input schema."
        }
      },
      "additionalProperties": false
    },
    "ToolSource": {
      "description": "Where a tool node's operations came from.\n\n`raw` is retained deliberately: §3d rule 5 requires re-import to diff operations by `method+path` and keep existing fills, and you cannot diff against a previous spec that was never stored.",
      "type": "object",
      "required": [
        "format",
        "imported_at"
      ],
      "properties": {
        "format": {
          "$ref": "#/definitions/ToolFormat"
        },
        "imported_at": {
          "$ref": "#/definitions/Timestamp"
        },
        "raw": {
          "description": "The document as imported. Empty for `manual`.",
          "default": "",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "VaultConfig": {
      "description": "Vault config carries only the *key names*. Values are write-only through `PUT /v1/vault/:id/:key`, stored encrypted, and never returned by `GET /v1/board`.",
      "type": "object",
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Wire": {
      "description": "An outgoing wire, as stored on its source node (`Node::wires`).",
      "type": "object",
      "required": [
        "to",
        "type"
      ],
      "properties": {
        "to": {
          "description": "Target node id.",
          "type": "string",
          "format": "uuid"
        },
        "type": {
          "$ref": "#/definitions/WireType"
        }
      }
    },
    "WireType": {
      "description": "What a wire permits. Wires are directional and stored on the *source* node.",
      "oneOf": [
        {
          "description": "Read the target's data (`wheel read`, `table query`, `chest get|ls`, `secret get`, `run <script>`, MCP attachment).",
          "type": "string",
          "enum": [
            "read"
          ]
        },
        {
          "description": "Mutate the target's data. For `table` and `chest`, write **implies** read — see [`WireType::satisfies`].",
          "type": "string",
          "enum": [
            "write"
          ]
        },
        {
          "description": "Deliver a message to the target (agent→agent, endpoint→agent, script→agent) or, for `ctx`→`agent`, inject context into its prompt.",
          "type": "string",
          "enum": [
            "send"
          ]
        }
      ]
    }
  }
}
